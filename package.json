{
  "name": "preplytool-v2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --watch-path=server --watch-path=.env server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run build:server && vite build",
    "build:server": "node scripts/build-server.js",
    "pretest": "npm run build:server",
    "start": "node server/index.js",
    "db:restore": "node scripts/restore.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test",
    "db:check": "node scripts/check-db.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vitejs/plugin-react": "^4.7.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "htmlparser2": "12.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "2.18.0",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
